@model VestindoSonhos.Models.Beneficiario
<link rel="stylesheet" href="~/css/formularios.css" />

@{
    ViewData["Title"] = "Apagar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-formulario">

    <div class="btn-back">
        <a asp-controller="Beneficiarios" asp-action="Index"> <i class="material-symbols-outlined">arrow_back_ios</i>Voltar</a>
    </div>

    <div class="form-card">
        <h1>Apagar Beneficiário</h1>
        <h4>Tem certeza que deseja apagar este beneficiário?</h4>
        <div>
            <hr />
            <dl class="form-context row">
                <dt class="col-sm-2">Nome</dt>
                <dd class="col-sm-10">@Html.DisplayFor(model => model.Nome)</dd>
                <dt class="col-sm-2">Telefone</dt>
                <dd class="col-sm-10">@Html.DisplayFor(model => model.Telefone)</dd>
                <dt class="col-sm-2">Endereço</dt>
                <dd class="col-sm-10">@Html.DisplayFor(model => model.Endereco)</dd>
                <dt class="col-sm-2">Situação</dt>
                <dd class="col-sm-10">@Html.DisplayFor(model => model.Situacao)</dd>
                <dt class="col-sm-2">Observação</dt>
                <dd class="col-sm-10">@Html.DisplayFor(model => model.Observacao)</dd>
            </dl>

            <form asp-action="Apagar">
                <input type="hidden" asp-for="Id" />
                <input type="submit" value="Apagar" class="btn btn-danger" />
            </form>
        </div>
    </div>
</div>