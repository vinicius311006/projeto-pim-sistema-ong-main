@model VestindoSonhos.Models.Produto
<link rel="stylesheet" href="~/css/formularios.css" />

@{
    ViewData["Title"] = "Apagar Produto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-formulario">

    <div class="btn-back">
        <a asp-controller="Produtos" asp-action="Index"> <i class="material-symbols-outlined">arrow_back_ios</i>Voltar</a>
    </div>

    <div class="form-card">
        <h1>Apagar Produto</h1>
        <h4>Tem certeza que deseja apagar este produto?</h4>

        <div>
            <hr />
            <dl class="form-context row">
                <dt class="col-sm-2">Nome</dt>
                <dd class="col-sm-10">@Html.DisplayFor(model => model.Nome)</dd>
                <dt class="col-sm-2">Descrição</dt>
                <dd class="col-sm-10">@Html.DisplayFor(model => model.Descricao)</dd>
                <dt class="col-sm-2">Cor</dt>
                <dd class="col-sm-10">@Html.DisplayFor(model => model.Cor)</dd>
                <dt class="col-sm-2">Categoria</dt>
                <dd class="col-sm-10">@Html.DisplayFor(model => model.CategoriaNavigation!.Categoria)</dd>
            </dl>

            <form asp-action="Apagar">
                <input type="hidden" asp-for="Id" />
                <input type="submit" value="Apagar" class="btn btn-danger" />
            </form>
        </div>
    </div>
</div>
