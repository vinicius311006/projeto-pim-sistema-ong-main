@model IEnumerable<VestindoSonhos.ViewModels.InventarioSimplesViewModel>
<link rel="stylesheet" href="~/css/tabela.css">

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class= 'container-tabela'>
<h1>Inventário</h1>

<div class="card">

<div class="card-topo">
    <h3>Detalhes do Inventário</h3>
    <div style="display: flex; gap: 10px; flex-wrap: wrap;">
        <a class="btn btn-primary" asp-controller="Produtos" asp-action="Index"><span class="material-symbols-outlined">inventory_2</span>Produtos</a>
        <a class="btn btn-primary" asp-controller="Produtos" asp-action="Criar"><span class="material-symbols-outlined">add_box</span>Novo Produto</a>
        <a class="btn btn-primary" asp-action="Criar"><span class="material-symbols-outlined">add</span>Nova Movimentação</a>
    </div>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(Model => Model.Razao)
            </th>
            <th>
                Produto
            </th>
            <th>
                @Html.DisplayNameFor(Model => Model.Quantidade)
            </th>
            <th>
                @Html.DisplayNameFor(Model => Model.Hora)
            </th>
            <th> </th>
            <th> </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td data-label="Razão">
                @Html.DisplayFor(modelItem => item.Razao)
            </td>
            <td data-label="Produto">
                @Html.DisplayFor(modelItem => item.NomeProduto)
            </td>
            <td data-label="Quantidade">
                @Html.DisplayFor(modelItem => item.Quantidade)
            </td>
            <td data-label="Hora">
                @Html.DisplayFor(modelItem => item.Hora)
            </td>
            <td data-label="Id">
                    <input hidden type="text" name="Id" value="@Html.DisplayFor(modelItem => item.Id)"/>
            </td>
            <td>
                    <a asp-action="Editar" asp-route-id="@item.TransacaoId"><span class="material-symbols-outlined">edit</span>Editar</a>                       
                    <a asp-action="Details" asp-route-id="@item.TransacaoId"><span class="material-symbols-outlined">search</span>Detalhes</a>
                    <a asp-action="Apagar" asp-route-id="@item.TransacaoId"><span class="material-symbols-outlined">delete</span>Apagar</a>
            </td>
        </tr>
}
    </tbody>
</table>
</div>
</div>