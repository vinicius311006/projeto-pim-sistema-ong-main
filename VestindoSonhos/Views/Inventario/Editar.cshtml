@model VestindoSonhos.ViewModels.TransacaoInventarioCriacaoEdicaoViewModel
@{
	ViewData["Title"] = "Editar";
	Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container-formulario">
	<div class="btn-back">
		<a asp-controller="Inventario" asp-action="Index"> <i class="material-symbols-outlined">arrow_back_ios</i>Voltar</a>
	</div>
	<div class="form-card">
		<h1>Editar Transação</h1>
		<form class="form-context" asp-action="Editar">
			<div asp-validation-summary="ModelOnly" class="text-danger"></div>
			<input type="hidden" name="IdTransacao" value="@Model.IdTransacao"/>
			<div class="form-group">
				<label asp-for="Razao" class="control-label">Razão</label>
				<select asp-for="Razao" class="form-control" asp-items="ViewBag.Razao"></select>
				<span asp-validation-for="Razao" asp-items="ViewBag.Razao" class="text-danger"></span>
			</div>
			<div class="form-group">
				<label asp-for="CategoriaTransacao" class="control-label">Categoria</label>
				<select asp-for="CategoriaTransacao" class="form-control" asp-items="ViewBag.Categoria"></select>
				<span asp-validation-for="CategoriaTransacao" asp-items="ViewBag.Categoria" class="text-danger"></span>
				<a asp-controller="Categoria" asp-action="Criar" asp-route-returnUrl="@Context.Request.Path"> + </a>
			</div>
			<div class="form-group">
				<label asp-for="Beneficiario" class="control-label">Beneficiários</label>
				<select asp-for="Beneficiario" class="form-control" asp-items="ViewBag.Beneficiarios">
					<option value="">Sem beneficiário atribuído.</option>
				</select>
				<span asp-validation-for="Beneficiario" class="text-danger"></span>
			</div>
			<div class="form-group">
				<label asp-for="Observacao" class="control-label">Observação</label>
				<textarea asp-for="Observacao" class="form-control"></textarea>
				<span asp-validation-for="Observacao" class="text-danger"></span>
			</div>
			<div style="background: #EEF2FF; border: 1px solid #C7D2FE; border-radius: 8px; padding: 12px 16px; margin: 15px 0; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
				<p style="margin: 0; color: #3730A3; font-size: 13px; line-height: 1.5; flex: 1;">
					📦 <strong>Itens da movimentação:</strong> Marque a caixinha do produto desejado e informe a quantidade.
				</p>
				<div style="display: flex; gap: 8px; flex-wrap: wrap;">
					<a asp-controller="Produtos" asp-action="Criar" class="btn btn-primary" style="text-decoration: none; display: inline-flex; align-items: center; gap: 4px; font-size: 13px; padding: 6px 12px;">
						<span class="material-symbols-outlined" style="font-size: 18px;">add</span> Novo Produto
					</a>
					<a asp-controller="Produtos" asp-action="Index" class="btn btn-secondary" style="text-decoration: none; display: inline-flex; align-items: center; gap: 4px; font-size: 13px; padding: 6px 12px;">
						<span class="material-symbols-outlined" style="font-size: 18px;">inventory_2</span> Ver Produtos
					</a>
				</div>
			</div>
			<div class="container-tabela">
				<div class="card">

					<table class="table table-striped">

						<thead>
							<tr>
								<th></th>
								<th>Nome</th>
								<th>Descrição</th>
								<th>Categoria</th>
								<th>Cor</th>
								<th>Quantidade</th>
							</tr>
						</thead>

						<tbody>

							@for (int i = 0; i < Model.Produtos.Count; i++)
							{
								<tr class="produto-item">

									<td>
										<input type="hidden" name="Produtos[@i].ProdutoId" value="@Model.Produtos[i].ProdutoId" />
										@Html.CheckBoxFor(m => m.Produtos[@i].Selecionado, new { @class = "produto-check" })

									</td>

									<td>
										@Model.Produtos[i].NomeProduto
									</td>
									<td>
										@Model.Produtos[i].Descricao
									</td>
									<td>
										@Model.Produtos[i].NomeCategoriaProduto
									</td>
									<td>
										@Model.Produtos[i].Cor
									</td>

									<td>
										<input @(Model.Produtos[i].Selecionado ? "" : "disabled") style="max-width: 50px" type="number" name="Produtos[@i].Quantidade" min="1" value="@Model.Produtos[i].Quantidade" class="quantidade-input" />
									</td>

								</tr>
							}

						</tbody>

					</table>

				</div>
			</div>
			<div class="form-group">
				<input type="submit" value="Salvar" class="btn btn-primary" />
			</div>
		</form>
	</div>
</div>
	<script>
			document.querySelectorAll(".produto-check")
				.forEach(check => {
	
					check.addEventListener("change", function () {
	
						const quantidade =
							this.closest(".produto-item")
								.querySelector(".quantidade-input");
	
						quantidade.disabled = !this.checked;
	
					if (!this.checked)
					{
						quantidade.value = "";
					}
					else
					{
						quantidade.value = 1;
					}
						});
				});
	
	</script>