@model VestindoSonhos.ViewModels.TransacaoInventarioCriacaoEdicaoViewModel
@{
	ViewData["Title"] = "Criar";
	Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container-formulario">
	<div class="btn-back">
		<a asp-controller="Inventario" asp-action="Index"> <i class="material-symbols-outlined">arrow_back_ios</i>Voltar</a>
	</div>
	<div class="form-card">
		<h1>Criar Transação</h1>
		<form class="form-context" asp-action="Criar">
			<div asp-validation-summary="ModelOnly" class="text-danger"></div>
			<div class="form-group">
				<label asp-for="Razao" class="control-label">Razão</label>
				<select asp-for="Razao" class="form-control" asp-items="ViewBag.Razao"></select>
				<span asp-validation-for="Razao" asp-items="ViewBag.Razao" class="text-danger"></span>
			</div>
			<div class="form-group">
				<label asp-for="CategoriaTransacao" class="control-label">Categoria</label>
				<select asp-for="CategoriaTransacao" class="form-control" asp-items="ViewBag.Categoria"></select>
				<span asp-validation-for="CategoriaTransacao" asp-items="ViewBag.Categoria" class="text-danger"></span>
				<a asp-controller="Categoria" asp-action="Criar" asp-route-returnUrl="@Context.Request.Path"> + </a>
			</div>
			<div class="form-group">
				<label asp-for="Beneficiario" class="control-label">Beneficiários</label>
				<select asp-for="Beneficiario" class="form-control" asp-items="ViewBag.Beneficiarios">
				<option value="">Sem beneficiário atribuído.</option>
				</select>
				<span asp-validation-for="Beneficiario" class="text-danger"></span>
			</div>
			<div class="form-group">
				<label asp-for="Observacao" class="control-label">Observação</label>
				<textarea asp-for="Observacao" class="form-control" maxlength="255"></textarea>
				<span asp-validation-for="Observacao" class="text-danger"></span>
			</div>

			<div style="background: #EEF2FF; border: 1px solid #C7D2FE; border-radius: 8px; padding: 12px 16px; margin: 15px 0;">
				<p style="margin: 0; color: #3730A3; font-size: 13px; line-height: 1.5;">
					📦 <strong>Como adicionar itens:</strong> Na lista de produtos abaixo, <strong>marque a caixinha</strong> do produto desejado e <strong>digite a quantidade</strong> que está entrando ou saindo.
				</p>
			</div>

			@if (Model.Produtos == null || !Model.Produtos.Any())
			{
				<div style="background: #FFFBEB; border: 1px solid #FDE68A; border-radius: 8px; padding: 15px; margin: 15px 0; color: #92400E;">
					<h4 style="margin: 0 0 6px; font-size: 15px; font-weight: 600;">⚠️ Nenhum produto cadastrado no catálogo</h4>
					<p style="margin: 0 0 10px; font-size: 13px;">O Inventário registra a movimentação de estoque de produtos já cadastrados. Para adicionar peças, primeiro cadastre o produto no menu <strong>Produtos</strong>.</p>
					<a asp-controller="Produtos" asp-action="Criar" class="btn btn-primary" style="text-decoration: none; display: inline-block;">+ Cadastrar Novo Produto</a>
				</div>
			}

			<div class="container-tabela">
				<div class="card">

					<table class="table table-striped">

						<thead>
							<tr>
								<th></th>
								<th>Nome</th>
								<th>Descrição</th>
								<th>Categoria</th>
								<th>Cor</th>
								<th>Quantidade</th>
							</tr>
						</thead>

						<tbody>

							@for (int i = 0; i < Model.Produtos.Count; i++)
							{
								<tr class="produto-item">

									<td>
										<input type="hidden" name="Produtos[@i].ProdutoId" value="@Model.Produtos[i].ProdutoId" />
										@Html.CheckBoxFor(m => m.Produtos[i].Selecionado, new { @class = "produto-check" })
									</td>

									<td>
										@Model.Produtos[i].NomeProduto
									</td>
									<td>
										@Model.Produtos[i].Descricao
									</td>
									<td>
										@Model.Produtos[i].NomeCategoriaProduto
									</td>
									<td>
										@Model.Produtos[i].Cor
									</td>

									<td>
										<input style="max-width: 50px" type="number" name="Produtos[@i].Quantidade" min="1" disabled class="quantidade-input" />
									</td>

								</tr>
							}

						</tbody>

					</table>

				</div>
			</div>
			<div class="form-group">
				<input type="submit" value="Criar" class="btn btn-primary" />
			</div>
			</form>
		</div>
	<script>
		document.querySelectorAll(".produto-check")
			.forEach(check => {
	
				check.addEventListener("change", function () {
	
					const quantidade =
						this.closest(".produto-item")
							.querySelector(".quantidade-input");
	
					quantidade.disabled = !this.checked;
	
				if (!this.checked)
				{
					quantidade.value = "";
				}
				else
				{
					quantidade.value = 1;
				}
					});	
			});
	
	</script>