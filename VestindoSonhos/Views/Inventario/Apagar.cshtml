@model VestindoSonhos.ViewModels.TransacaoInventarioViewModel

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-formulario">

    <div class="btn-back">
        <a asp-controller="Inventario" asp-action="Index"> <i class="material-symbols-outlined">arrow_back_ios</i>Voltar</a>
    </div>


    <h4>Apagar</h4>
    <h4>Tem certeza que deseja apagar este item?</h4>
        
    <div>
        <hr />
        <h1>Transação - Inventário</h1>
        <dl class="form-context">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Usuario)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.UsuarioNavigation.Nome)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Categoria)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CategoriaNavigation.Nome)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Hora)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Hora)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Observacao)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Observacao)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Razao)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Razao)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Beneficiario)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.BeneficiarioNavigation.Nome)
        </dd>
    </dl>
</div>
<input hidden name="Id" value=@Model.IdTransacao />
<h2>Atenção! Todas as transações abaixo são vinculadas à esta e consequentemente serão apagadas junto.</h2>
<div class="container-tabela">
    <div class="card">
        <table class="table-striped table">
            <thead>
                <tr>
                    <th>
                        Id
                    </th>
                    <th>
                        Nome
                    </th>
                    <th>
                        Cor
                    </th>
                    <th>
                        Categoria
                    </th>
                    <th>
                        Quantidade
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.listaItensAtribuidos)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.ProdutoNavigation.Id)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.ProdutoNavigation.Nome)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.ProdutoNavigation.Cor)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.CategoriaNavigation.Categoria)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Quantidade)
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
    
    <form asp-action="Apagar">
        <input type="hidden" asp-for=@Model.ProdutoNavigation.Id/>
        <input type="hidden" asp-for=@Model.IdTransacao />
    <input type="submit" value="Apagar" class="btn btn-danger" />
    </form>
</div>
