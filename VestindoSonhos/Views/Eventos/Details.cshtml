@model VestindoSonhos.ViewModels.DetalhesEventoViewModel
<link rel="stylesheet" href="~/css/formularios.css" />

@{
    ViewData["Title"] = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container-formulario">

    <div class="btn-back">
        <a asp-controller="Eventos" asp-action="Index"> <i class="material-symbols-outlined">arrow_back_ios</i>Voltar</a>
    </div>


    <div class="form-card">
        <h1>Detalhes</h1>

        <div>
            <h4>Eventos</h4>
            <hr />
            <dl class="form-context row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.evento.Nome)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.evento.Nome)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.evento.data_inicio)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.evento.data_inicio)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.evento.Local)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.evento.Local)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.evento.data_fim)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.evento.data_fim)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.evento.Responsavel)
        </dt>
        <dd class = "col-sm-10">
            @Model.evento.ResponsavelNavigation?.Nome
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.evento.Observacao)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.evento.Observacao)
        </dd>
    </dl>
    <div>
        <a asp-action="Editar" asp-route-id="@Model?.evento.Id">Editar</a>
    </div>
</div>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.listaVoluntarios[0].Nome)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.listaVoluntarios[0].Telefone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.listaVoluntarios[0].Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.listaVoluntarios[0].Endereco)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.listaVoluntarios[0].Cpf)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.listaVoluntarios)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Nome)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Telefone)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Email)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Endereco)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Cpf)
                </td>
                <td>
                    <a asp-controller="Voluntarios" asp-action="Editar" asp-route-id="@item.Id">Editar</a> |
                    <a asp-controller="Voluntarios" asp-action="Details" asp-route-id="@item.Id">Details</a> |
                </td>
            </tr>
        }
    </tbody>
    </table>
</div>
</div>