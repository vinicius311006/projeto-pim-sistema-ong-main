@model VestindoSonhos.Models.TiposAtivo
<link rel="stylesheet" href="~/css/formularios.css" />

@{
    ViewData["Title"] = "Apagar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-formulario">

    <div class="btn-back">
        <a asp-controller="TiposAtivo" asp-action="Index"> <i class="material-symbols-outlined">arrow_back_ios</i>Voltar</a>
    </div>


    <h4>Apagar</h4>
    <h4>Tem certeza que deseja apagar este item?</h4>
        
    <div>
        <hr />
        <h1>Tipos de Ativo</h1>
        <dl class="form-context row">
            <dt class = "col-sm-2">
                @Html.DisplayNameFor(model => model.Categoria)
            </dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.Categoria)
            </dd>
        </dl>
    
    <form asp-action="Apagar">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Apagar" class="btn btn-danger" />
    </form>
</div>
