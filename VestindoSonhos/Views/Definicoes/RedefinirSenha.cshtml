@model VestindoSonhos.ViewModels.RedefinicaoViewModel
<link rel="stylesheet" href="~/css/formularios.css" />

@{
    ViewData["Title"] = "Redefinir Senha";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-formulario">

    <div class="btn-back">
        <a asp-controller="Home" asp-action="Index"> <i class="material-symbols-outlined">arrow_back_ios</i>Voltar</a>
    </div>


    <div class="form-card">
        <h1>Redefinir Senha</h1>
	<form class="form-context" asp-action="RedefinirSenha">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input hidden asp-for="Id" class="form-control" />
            <div class="form-group">
                <label asp-for="SenhaAtual" class="control-label">Senha atual</label>
                <input type="password" asp-for="SenhaAtual" class="form-control" required />
                <span asp-validation-for="SenhaAtual" class="text-danger"></span>
                <br />
                <label asp-for="SenhaNova" class="control-label">Senha nova</label>
                <input type="password" asp-for="SenhaNova" class="form-control" required />
                <span asp-validation-for="SenhaNova" class="text-danger"></span>
                <br />
                <label asp-for="RepeteSenhaNova" class="control-label"></label>
                <input type="password" asp-for="RepeteSenhaNova" class="form-control" required />
                <span asp-validation-for="RepeteSenhaNova" class="text-danger"></span>
                <br />

            </div>
            <div class="form-group">
                <input type="submit" value="Salvar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

