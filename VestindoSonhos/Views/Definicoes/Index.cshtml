@section Scripts {
    <script>
        function atualizarCardsTema() {
            var isDark = document.documentElement.classList.contains('dark-mode');
            var cardLight = document.getElementById('cardThemeLight');
            var cardDark = document.getElementById('cardThemeDark');
            if (cardLight && cardDark) {
                cardLight.classList.toggle('active-theme', !isDark);
                cardDark.classList.toggle('active-theme', isDark);
            }
        }
        document.addEventListener('DOMContentLoaded', atualizarCardsTema);
    </script>
}
