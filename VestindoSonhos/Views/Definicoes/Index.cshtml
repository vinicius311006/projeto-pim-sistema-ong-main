                                            <td class="text-end text-success fw-semibold">Ativo</td>
                                        </tr>
                                        <tr>
                                            <td><span class="badge bg-success">GET / POST</span></td>
                                            <td><code>/api/inventario</code></td>
                                            <td>Controle de Estoque e Doações em Campo</td>
                                            <td class="text-end text-success fw-semibold">Ativo</td>
                                        </tr>
                                        <tr>
                                            <td><span class="badge bg-success">GET / POST</span></td>
