@model VestindoSonhos.Models.Cargo
<link rel="stylesheet" href="~/css/formularios.css" />

@{
    ViewData["Title"] = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-formulario">

    <div class="btn-back">
        <a asp-controller="Cargos" asp-action="Index"> <i class="material-symbols-outlined">arrow_back_ios</i>Voltar</a>
    </div>


    <div class="form-card">
        <h1>Detalhes</h1>
        <div class="form-context">
            <h4>Cargo</h4>
            <hr />
            <dl class="row">
                <dt class = "col-sm-2">
                    @Html.DisplayNameFor(model => model.Nome)
                </dt>
                <dd class = "col-sm-10">
                    @Html.DisplayFor(model => model.Nome)
                </dd>
            </dl>
            
            <div>
                <a class="btn btn-primary" asp-action="Editar" asp-route-id="@Model?.Id">Editar</a>
            </div>
        </div>
    </div>
</div>
