@model IEnumerable<VestindoSonhos.Models.Cargo>
@using System.Linq

@{
    ViewData["Title"] = "Cargos e Permissões";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var lista = Model ?? Enumerable.Empty<VestindoSonhos.Models.Cargo>();
}

<link rel="stylesheet" href="~/css/tabela.css" />

<div class="container-tabela">
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:14px;">
        <div>
            <h1>Cargos &amp; Níveis de Permissão</h1>
            <p style="margin:4px 0 0; color:var(--text-2, #6B7280); font-size:13.5px;">
                Perfis de acesso atribuídos aos usuários e colaboradores da ONG
            </p>
        </div>
        <div style="display:flex; gap:10px; flex-wrap:wrap;">
            <a class="btn" asp-controller="Usuarios" asp-action="Index" style="background:var(--color-5, #FFF); border:1px solid var(--color-6, #D1D5DB); color:var(--text-1, #374151);">
                <span class="material-symbols-outlined">arrow_back</span>
                <span>Voltar para Usuários</span>
            </a>
            <a class="btn btn-primary" asp-action="Create">
                <span class="material-symbols-outlined">add_circle</span>
                <span>Novo Cargo</span>
            </a>
        </div>
    </div>

    <div class="card">
        <div style="overflow-x:auto;">
            <table class="table">
                <thead>
                    <tr>
                        <th>Cargo / Função</th>
                        <th style="text-align:right;">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in lista)
                    {
                        <tr>
                            <td><strong>@item.Nome</strong></td>
                            <td style="text-align:right;">
                                <div class="vs-actions">
                                    <a asp-action="Editar" asp-route-id="@item.Id" class="vs-pill-btn vs-pill-edit">
                                        <span class="material-symbols-outlined">edit</span>Editar
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="vs-pill-btn vs-pill-view">
                                        <span class="material-symbols-outlined">visibility</span>Detalhes
                                    </a>
                                    <a asp-action="Apagar" asp-route-id="@item.Id" class="vs-pill-btn vs-pill-del">
                                        <span class="material-symbols-outlined">delete</span>Excluir
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
