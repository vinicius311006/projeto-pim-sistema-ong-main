@model VestindoSonhos.ViewModels.DefinirNovaSenhaViewModel
<link rel="stylesheet" href="~/css/formularios.css" />

@{
    ViewData["Title"] = "Redefinição de senha";
}
<div class="container-formulario">

    <div class="btn-back">
        <a asp-controller="Home" asp-action="Index"> <i class="material-symbols-outlined">arrow_back_ios</i>Voltar</a>
    </div>


    <div class="form-card">
        <h1>Definir nova senha</h1>
        <form class="form-context" asp-action="DefinirNovaSenha">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Email" class="control-label"></label>
                <input type="email" asp-for="Email" class="form-control" required/>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Cpf" class="control-label"></label>
                <input asp-for="Cpf" class="form-control" required />
                <span asp-validation-for="Cpf" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SenhaNova" class="control-label">Digite a nova senha:</label>
                <input type="password" asp-for="SenhaNova" class="form-control" required />
                <span asp-validation-for="SenhaNova" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="RepeteSenhaNova" class="control-label">Repita a nova senha:</label>
                <input type="password" asp-for="RepeteSenhaNova" class="form-control" required />
                <span asp-validation-for="RepeteSenhaNova" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Solicitar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
