@model VestindoSonhos.ViewModels.TransacaoFinanceiraEditViewModel

@{
    ViewData["Title"] = "Editar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-formulario">

    <div class="btn-back">
        <a asp-controller="Financeiro" asp-action="financeiro"> <i class="material-symbols-outlined">arrow_back_ios</i>Voltar</a>
    </div>


    <div class="form-card">
        <h1>Editar Transação</h1>
        <form class="form-context" asp-action="Editar">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Hora" class="control-label"></label>
                <input asp-for="Hora" class="form-control" asp-items="Model.Hora" />
                <span asp-validation-for="Hora" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Usuario" class="control-label">Usuário</label>
                <input hidden asp-for="UsuarioId" class="form-control" asp-items="Usuarioid" />
                <input disabled asp-for="Usuario" class="form-control" asp-items="Usuario" />
            </div>
            <div class="form-group">
                <label asp-for="Observacao" class="control-label"></label>
                <input asp-for="Observacao" class="form-control" asp-items="Model.Observacoes" maxlength="255" />
                <span asp-validation-for="Observacao" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Categoria" class="control-label"></label>
                <select asp-for="Categoria" class="form-control" asp-items="ViewBag.Categoria"></select>
                <a asp-controller="Categoria" asp-action="Criar" asp-route-returnUrl="@Context.Request.Path">+</a>
            </div>
            <div class="form-group">
                <label asp-for="Valor" class="control-label"></label>
                <input asp-for="Valor" class="form-control text-success" asp-items="Model.Valor"/>
                <span asp-validation-for="Valor" class="text-success"></span>
            </div>
            <div class="form-group">
                <label asp-for="Carteira" class="control-label"></label>
                <select asp-for="Carteira" class="form-control" asp-items="ViewBag.Carteira"></select>
            </div>
            <div class="form-group">
                <label asp-for="Razao" class="control-label"></label>
                <input readonly asp-for="Razao" class="form-control" asp-items="Model.Razao"/>
            </div>
            <div class="form-group">
                <input type="submit" value="Salvar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

