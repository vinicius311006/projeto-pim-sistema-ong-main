@model IEnumerable<VestindoSonhos.ViewModels.TransacaoFinanceiraViewModel>
@using System.Globalization
@using System.Linq

@{
    ViewData["Title"] = "Histórico de Doações";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var ptBr = new CultureInfo("pt-BR");
    var lista = Model ?? Enumerable.Empty<VestindoSonhos.ViewModels.TransacaoFinanceiraViewModel>();
}

<link rel="stylesheet" href="~/css/tabela.css">

<div class="container-tabela">
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; margin-bottom:16px;">
        <div>
            <h1 style="text-align:left; margin:0; font-size:26px;">Doações Financeiras Recebidas</h1>
            <p style="margin:4px 0 0; color:#6B7280; font-size:13.5px;">Histórico completo de contribuições financeiras registradas na ONG</p>
        </div>
        <div style="display:flex; gap:10px; flex-wrap:wrap;">
            <a class="btn" asp-action="Financeiro" style="background:var(--color-5, #FFF); border:1px solid var(--color-6, #D1D5DB); color:var(--text-1, #374151); padding:10px 16px; border-radius:10px; font-weight:600; display:inline-flex; align-items:center; gap:6px; text-decoration:none;">
                <span class="material-symbols-outlined">arrow_back</span>Voltar ao Financeiro
            </a>
            <a class="btn btn-primary" asp-action="Criar" asp-route-origem="Doacoes" style="background:#059669; color:#FFF; padding:10px 18px; border-radius:10px; font-weight:600; display:inline-flex; align-items:center; gap:6px;">
                <span class="material-symbols-outlined">volunteer_activism</span>Nova Doação
            </a>
        </div>
    </div>

    <div class="card" style="max-height:none; overflow:visible;">
        <div style="overflow-x:auto;">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Tipo</th>
                        <th>Observação / Doador</th>
                        <th>Registrado por</th>
                        <th>Data / Hora</th>
                        <th>Valor (R$)</th>
                        <th style="text-align:center;">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in lista)
                    {
                        <tr>
                            <td data-label="Tipo">
                                <span style="display:inline-flex; align-items:center; gap:4px; padding:4px 10px; border-radius:20px; font-size:12px; font-weight:600; background:#ECFDF5; color:#059669;">
                                    ♥ @item.Razao
                                </span>
                            </td>
                            <td data-label="Obs.">
                                <strong>@(string.IsNullOrWhiteSpace(item.Observacao) ? "Doação recebida" : item.Observacao)</strong>
                            </td>
                            <td data-label="Usuário">
                                @item.Usuario
                            </td>
                            <td data-label="Hora">
                                @item.Hora.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td data-label="Valor" style="font-weight:700; color:#059669;">
                                + R$ @item.Valor.ToString("N2", ptBr)
                            </td>
                            <td style="text-align:center;">
                                <div style="display:inline-flex; gap:6px;">
                                    <a asp-action="Editar" asp-route-id="@item.Id" style="background:#EEF2FF; color:#4F46E5; padding:5px 10px; border-radius:6px; font-size:12px; font-weight:600; text-decoration:none; display:inline-flex; align-items:center; gap:4px;">
                                        <span class="material-symbols-outlined" style="font-size:15px;">edit</span>Editar
                                    </a>
                                    <a asp-action="Apagar" asp-route-id="@item.Id" style="background:#FEE2E2; color:#DC2626; padding:5px 10px; border-radius:6px; font-size:12px; font-weight:600; text-decoration:none; display:inline-flex; align-items:center; gap:4px;">
                                        <span class="material-symbols-outlined" style="font-size:15px;">delete</span>Excluir
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
