@model VestindoSonhos.Models.Dependente
<link rel="stylesheet" href="~/css/formularios.css" />

@{
    ViewData["Title"] = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-formulario">

    <div class="btn-back">
        <a asp-controller="Beneficiarios" asp-action="Index"> <i class="material-symbols-outlined">arrow_back_ios</i>Voltar</a>
    </div>


    <div class="form-card">
        <h1>Detalhes</h1>

        <div>
            <h4>Dependente</h4>
            <hr />
            <dl class="form-context row">
                <dt class = "col-sm-2">
                    @Html.DisplayNameFor(model => model.Nome)
                </dt>
                <dd class = "col-sm-10">
                    @Html.DisplayFor(model => model.Nome)
                </dd>
                <dt class = "col-sm-2">
                    @Html.DisplayNameFor(model => model.Idade)
                </dt>
                <dd class = "col-sm-10">
                    @Html.DisplayFor(model => model.Idade)
                </dd>
                <dt class = "col-sm-2">
                    @Html.DisplayNameFor(model => model.Sexo)
                </dt>
                <dd class = "col-sm-10">
                    @Html.DisplayFor(model => model.Sexo)
                </dd>
                <dt class = "col-sm-2">
                    @Html.DisplayNameFor(model => model.Parentesco)
                </dt>
                <dd class = "col-sm-10">
                    @Html.DisplayFor(model => model.Parentesco)
                </dd>
                <dt class = "col-sm-2">
                    Responsável
                </dt>
                <dd class = "col-sm-10">
                    @Html.DisplayFor(model => model.IdResponsavelNavigation.Nome)
                </dd>
            </dl>
            <div>
                <a asp-action="Editar" asp-route-id="@Model?.Id">Editar</a>
            </div>
        </div>
    </div>
</div>
