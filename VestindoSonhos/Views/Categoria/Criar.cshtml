@model VestindoSonhos.Models.Categoria
<link rel="stylesheet" href="~/css/formularios.css" />
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-formulario">

    <div class="btn-back">
        @if (@ViewBag.ReturnUrl != null)
        {
            <a href="@ViewBag.ReturnUrl"><i class="material-symbols-outlined">arrow_back_ios</i>Voltar</a>
        }
        else
        {
            <a asp-controller="Categoria" asp-action="Index"> <i class="material-symbols-outlined">arrow_back_ios</i>Voltar</a>
        }
    </div>


    <div class="form-card row">
        <h1>Criar Categoria</h1>
        <form class="form-context" asp-action="Criar">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Nome" class="control-label"></label>
                <input asp-for="Nome" class="form-control" maxlength="15" />
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                @* Não remover o hidden input acima, ele mantém guardado a página que irá voltar, se necessário *@
            </div>
            <div class="form-group">
                    <input type="submit" value="Criar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>