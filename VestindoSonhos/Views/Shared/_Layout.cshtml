<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VestindoSonhos</title>
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/VestindoSonhos.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tabela.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/formularios.css" />


    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined"  />
</head>
<body>
    @if (TempData["Erro"] != null)
    {
        <div class="toast-erro">
            @TempData["Erro"]
        </div>
    }
    @if (TempData["Sucesso"] != null)
    {
        <div class="toast-sucesso">
            @TempData["Sucesso"]
        </div>
    }
<header>

    <nav class="sidebar">


        <div class="sidebar-context">
        
        <button class="btn-open"><i class="material-symbols-outlined">menu</i></button>  

        <div class="sidebar-header ">
        <img title="Vestindo Sonhos" src="~/images/logo.png" alt="Logotipo Vestindo Sonhos">
        <a asp-controller="Home" asp-action="Index">VestindoSonhos</a> 
        </div>

       <div class="sidebar-menu ">
        
        @if (User.IsInRole("Colaborador") || User.IsInRole("Administrador"))
        {
            <ul>
                <li class="items">
                    <a title="Home" class="" asp-controller="Home" asp-action="Index"><i class="material-symbols-outlined">home</i><span>Home</span></a>
                </li>
                @if (User.IsInRole("Administrador"))
                {
                    <li>
                        <a title="Financeiro" class="" asp-area="" asp-controller="Financeiro" asp-action="Financeiro"><i class="material-symbols-outlined">volunteer_activism</i>Financeiro</a>
                    </li>
                }
                <li class="items ">
                    <a title="Inventário" class="" asp-area="" asp-controller="Inventario" asp-action="Index"><i class="material-symbols-outlined">box</i><span>Inventário</span></a>
                </li>
                @if (User.IsInRole("Administrador"))
                {
                    <li class="items">
                        <a title="Usuários" class="" asp-area="" asp-controller="Usuarios" asp-action="Index"><i class="material-symbols-outlined">account_circle</i><span>Usuários</span></a>
                    </li>
                }
                <li class="items ">
                    <a title="Eventos" class="" asp-area="" asp-controller="Eventos" asp-action="Index"><i class="material-symbols-outlined">calendar_month</i><span>Eventos</span></a>
                </li>
                <li class="items ">
                    <a title="Beneficiários" class="" asp-area="" asp-controller="Beneficiarios" asp-action="Index"><i class="material-symbols-outlined">person_heart</i><span>Beneficiários</span></a>
                </li>
                @if (User.IsInRole("Administrador"))
                {
                    <li class="items ">
                        <a title="Dashboard" class="" asp-area="" asp-controller="Financeiro" asp-action="Dashboard"><i class="material-symbols-outlined">chart_data</i><span>Dashboard</span></a>
                    </li>
                }
            </ul>  
        }
    </div>  
        </div>

        <div class="sidebar-logout">
                <a title="Definições" class="" asp-area="" asp-controller="Definicoes" asp-action="Index"><i class="material-symbols-outlined">settings</i>Definições</a>

            <form asp-area="" asp-controller="Login" asp-action="Logout" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <button id="logout" title="Logout" type="submit" class="link-like">
                    <i class="material-symbols-outlined">logout</i><span>Logout</span>
                </button>
            </form>
        </div>
    </nav>
</header>

    <div class="container">
        <main role="main" class="">
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <div vw class="enabled">
        <div vw-access-button class="active"></div>
        <div vw-plugin-wrapper>
            <div class="vw-plugin-top-wrapper"></div>
        </div>
    </div>
  <script src="https://vlibras.gov.br/app/vlibras-plugin.js"></script>
  <script>
    new window.VLibras.Widget('https://vlibras.gov.br/app');
  </script>
</body>
</html>
