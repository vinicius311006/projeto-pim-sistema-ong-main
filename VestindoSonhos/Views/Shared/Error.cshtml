@model ErrorViewModel
@{
    ViewData["Title"] = "Erro";
}

<h1 class="text-danger">Erro.</h1>
<h2 class="text-danger">Ocorreu um erro ao processar a sua solicitação.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>ID da Requisição:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Modo de Diagnóstico</h3>
<p>
    Caso o problema persista, entre em contato com o administrador do sistema informando o código da requisição acima.
</p>
